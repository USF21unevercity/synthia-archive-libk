# Telegram bot token from @BotFather
BOT_TOKEN=

# External PostgreSQL (Neon / Supabase / self-hosted). Never the Lovable built-in DB.
# Neon example: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Numeric Telegram user id of the platform owner (full, irrevocable access)
OWNER_ID=

# Optional default archive channel id (e.g. -1001234567890).
# Leave empty to defer archiving until a channel is configured.
ARCHIVE_CHANNEL_ID=

# error | warn | info | debug
LOG_LEVEL=info

# HTTP port for /health, /ready and /metrics probes
PORT=8080

# Optional PostgreSQL pool size
PG_POOL_MAX=10

# ---- Webhook mode (recommended in production) ----
# Public HTTPS base url of this service. On Render, RENDER_EXTERNAL_URL is used
# automatically when this is empty. Leave both empty to use long polling.
WEBHOOK_URL=
# Path Telegram posts updates to
WEBHOOK_PATH=/telegram/webhook
# Optional: secret token verified on each delivery (auto-derived from BOT_TOKEN if empty)
WEBHOOK_SECRET=
