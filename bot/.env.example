# Telegram bot token from @BotFather
BOT_TOKEN=

# External PostgreSQL (Neon / Supabase / self-hosted). Never the Lovable built-in DB.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Numeric Telegram user id of the platform owner (full, irrevocable access)
OWNER_ID=

# Default archive channel id (e.g. -1001234567890)
ARCHIVE_CHANNEL_ID=

# error | warn | info | debug
LOG_LEVEL=info
