# Telegram bot token from @BotFather
BOT_TOKEN=

# External PostgreSQL (Neon / Supabase / self-hosted). Never the Lovable built-in DB.
# Neon example: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Numeric Telegram user id of the platform owner (full, irrevocable access)
OWNER_ID=

# Default archive channel id (e.g. -1001234567890)
ARCHIVE_CHANNEL_ID=

# error | warn | info | debug
LOG_LEVEL=info

# HTTP port for /health, /ready and /metrics probes
PORT=8080

# Optional PostgreSQL pool size
PG_POOL_MAX=10
